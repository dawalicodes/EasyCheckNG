<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ussd_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="8dip"
    app:cardElevation="10dip"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/grey_10"
    app:strokeWidth="0.5dip">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ad_attribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_medium"
                android:background="@drawable/bg_ads"
                android:padding="@dimen/spacing_small"
                android:text="Ads"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/white"
                app:layout_constraintLeft_toLeftOf="@id/ad_icon_card"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ad_icon_card"
                android:layout_width="50dip"
                android:layout_height="50dip"
                android:layout_margin="@dimen/spacing_large"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="10dip"
                app:cardElevation="6dip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ad_attribution">

                <ImageView
                    android:id="@+id/ad_icon"
                    android:layout_width="40dip"
                    android:layout_height="40dip"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_launcher" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ad_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:text=""
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                app:layout_constraintLeft_toRightOf="@id/ad_icon_card"
                app:layout_constraintTop_toTopOf="@id/ad_icon_card" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ad_body"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text=""
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textStyle="italic"
                android:visibility="gone"
                app:layout_constraintLeft_toLeftOf="@id/ad_icon_card"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ad_icon_card" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ad_media_cover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:descendantFocusability="blocksDescendants"
                app:layout_constraintTop_toBottomOf="@id/ad_body">

                <ImageView
                    android:id="@+id/ad_media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="300dip"
                    android:minHeight="150dip" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <RatingBar
                android:id="@+id/ad_rating"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone"
                app:layout_constraintLeft_toLeftOf="@id/ad_media_cover"
                app:layout_constraintTop_toBottomOf="@id/ad_media_cover" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ad_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_large"
                android:text="@string/ads"
                android:visibility="gone"
                app:cornerRadius="8dip"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ad_rating" />

            <ImageButton
                android:id="@+id/ad_close"
                android:layout_width="30dip"
                android:layout_height="30dip"
                android:layout_margin="@dimen/spacing_medium"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>