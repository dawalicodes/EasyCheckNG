<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/sim_image"
        android:layout_width="75dip"
        android:layout_height="35dip"
        android:layout_margin="@dimen/spacing_medium"
        android:src="@drawable/airtel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/sim_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_large"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="@color/grey_700"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/sim_image"
        app:layout_constraintLeft_toRightOf="@id/sim_image"
        app:layout_constraintTop_toTopOf="@id/sim_image" />
</androidx.constraintlayout.widget.ConstraintLayout>