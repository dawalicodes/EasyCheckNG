<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sim_card_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Header -->
    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="3dp"
        android:text="Select SIM"
        android:textColor="#292837"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Two SIM cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- SIM 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sim_card_one"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="#E7E5F5"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp">

                <FrameLayout
                    android:id="@+id/sim_logo_holder_one"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="@drawable/bg_sim_mtn"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/sim_logo_one"
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:contentDescription="SIM 1 network logo"
                        android:src="@drawable/logo_mtn" />

                </FrameLayout>

                <TextView
                    android:id="@+id/sim_network_name_one"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="3dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="MTN"
                    android:textColor="#171727"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/sim_logo_holder_one"
                    app:layout_constraintTop_toTopOf="@id/sim_logo_holder_one"
                    app:layout_constraintBottom_toTopOf="@id/sim_number_one" />

                <TextView
                    android:id="@+id/sim_number_one"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="3dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="SIM 1"
                    android:textColor="#9292AA"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/sim_logo_holder_one"
                    app:layout_constraintTop_toBottomOf="@id/sim_network_name_one" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SIM 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sim_card_two"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="#E7E5F5"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp">

                <FrameLayout
                    android:id="@+id/sim_logo_holder_two"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="@drawable/bg_sim_airtel"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/sim_logo_two"
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:layout_gravity="center"
                        android:contentDescription="SIM 2 network logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_airtel" />

                </FrameLayout>

                <TextView
                    android:id="@+id/sim_network_name_two"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Airtel"
                    android:textColor="#171727"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/sim_number_two"
                    app:layout_constraintEnd_toStartOf="@id/sim_selected_two"
                    app:layout_constraintStart_toEndOf="@id/sim_logo_holder_two"
                    app:layout_constraintTop_toTopOf="@id/sim_logo_holder_two" />

                <TextView
                    android:id="@+id/sim_number_two"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="3dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="SIM 2"
                    android:textColor="#9292AA"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toStartOf="@id/sim_selected_two"
                    app:layout_constraintStart_toEndOf="@id/sim_logo_holder_two"
                    app:layout_constraintTop_toBottomOf="@id/sim_network_name_two" />

                <ImageView
                    android:id="@+id/sim_selected_two"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Selected"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>