<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4.0dip">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@id/contact_bg_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4.0dip"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4.0dip"
            android:theme="@style/Theme.Material3.DayNight"
            app:endIconMode="none">
            <Spinner
                android:id="@+id/bank_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48.0dip"
                android:spinnerMode="dropdown"
                android:theme="@style/USSDTheme" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/recharge_phone_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4.0dip"
            android:layout_marginTop="4.0dip"
            android:layout_marginBottom="4.0dip"
            android:hint="@string/phone"
            android:theme="@style/Theme.Material3.DayNight"
            app:endIconDrawable="@drawable/ic_baseline_person_add_24"
            app:endIconMode="custom"
            app:endIconTint="@color/green_400"
            app:startIconDrawable="@drawable/ic_action_phone"
            app:startIconTint="@color/green_400">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/recharge_phone"
                android:layout_width="match_parent"
                android:textColor="@color/grey_700"
                android:layout_height="match_parent"
                android:inputType="phone"
                android:textColorHint="@color/grey_20" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4.0dip"
            android:hint="@string/amount"
            android:theme="@style/Theme.Material3.DayNight"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/amount_selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/grey_700"
                android:drawableStart="@drawable/ic_naira_24"
                android:drawableTint="@color/green_400"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sim_place_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contact_bg_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>