<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        style="@style/bottomCardViewBank"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/spacing_middle"
        app:cardCornerRadius="@dimen/spacing_middle"
        app:cardElevation="8.0dip">
        <GridView
            android:layout_margin="@dimen/spacing_large"
            android:verticalSpacing="@dimen/spacing_large"
            android:horizontalSpacing="@dimen/spacing_large"
            android:id="@+id/bank_grid_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:numColumns="3" />
    </androidx.cardview.widget.CardView>
</LinearLayout>