<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/sim_card_parent"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.button.MaterialButton
        style="@style/simOne"
        android:id="@+id/sim_one"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:icon="@mipmap/ic_launcher_round"
        app:iconSize="@dimen/spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@id/center_guide"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        style="@style/simTwo"
        android:id="@+id/sim_two"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:icon="@mipmap/ic_launcher_round"
        app:iconSize="@dimen/spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/center_guide"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/center_guide"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".5" />

    <com.google.android.material.textview.MaterialTextView
        android:elevation="4dp"
        android:id="@+id/sim_one_name"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/white"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="@id/sim_one"
        app:layout_constraintRight_toRightOf="@id/sim_one" />

    <com.google.android.material.textview.MaterialTextView
        android:elevation="4dp"
        android:id="@+id/sim_two_name"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/white"
        android:textSize="8sp"
        app:layout_constraintLeft_toLeftOf="@id/sim_two"
        app:layout_constraintTop_toTopOf="@id/sim_two" />
</androidx.constraintlayout.widget.ConstraintLayout>