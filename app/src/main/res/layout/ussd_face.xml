<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="8dip"
    app:cardElevation="10dip"
    app:strokeWidth="0.5dip"
    android:id="@+id/ussd_card"
    app:strokeColor="@color/grey_10"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ussd_parent"
        android:paddingVertical="@dimen/spacing_medium"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?selectableItemBackground">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ussd_icon_card"
            android:layout_width="50dip"
            android:layout_height="50dip"
            android:layout_margin="@dimen/spacing_large"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="10dip"
            app:cardElevation="6dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ussd_icon"
                android:layout_width="35dip"
                android:layout_height="35dip"
                android:layout_gravity="center"
                android:src="@drawable/access_bank" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/ussd_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_large"
            android:maxLines="1"
            app:layout_constraintHorizontal_bias="0"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@color/grey_700"
            android:textStyle="bold"
            app:layout_constraintRight_toLeftOf="@id/chip"
            app:layout_constraintLeft_toRightOf="@id/ussd_icon_card"
            app:layout_constraintTop_toTopOf="@id/ussd_icon_card" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/description"
            android:layout_width="0dip"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/grey_400"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="@id/ussd_icon_card"
            app:layout_constraintLeft_toLeftOf="@id/ussd_name"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintHorizontal_bias="0"
            android:layout_marginEnd="@dimen/spacing_small"
            app:layout_constraintTop_toBottomOf="@id/ussd_name" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip"
            android:visibility="gone"
            app:layout_constraintLeft_toRightOf="@id/ussd_name"
            app:layout_constraintHorizontal_bias="1"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_small"
            android:clickable="false"
            android:focusable="false"
            android:padding="@dimen/spacing_small"
            app:chipMinTouchTargetSize="@dimen/spacing_xsmall"
            app:chipMinHeight="@dimen/spacing_large"
            android:text="@string/charges_apply"
            android:textColor="@color/purple_700"
            android:textStyle="bold"
            android:textSize="11sp"
            app:chipBackgroundColor="@android:color/transparent"
            app:chipStrokeColor="@color/purple_700"
            app:chipStrokeWidth="1dip"
            app:layout_constraintBottom_toBottomOf="@id/ussd_name"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/ussd_name" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>